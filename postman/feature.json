    {
      "name": "Пользователь видит комментарии администратора при получении одного события",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const main = async () => {\r",
              "    const api = new API(pm);\r",
              "    const rnd = new RandomUtils();\r",
              "\r",
              "    try {\r",
              "        const user = await api.addUser(rnd.getUser());\r",
              "        const category = await api.addCategory(rnd.getCategory());\r",
              "\r",
              "        const event = await api.addEvent(\r",
              "            user.id,\r",
              "            rnd.getEvent(category.id)\r",
              "        );\r",
              "\r",
              "        const moderationComments = [\r",
              "            {\r",
              "                content: \"test comment 1\"\r",
              "            },\r",
              "            {\r",
              "                content: \"test comment 2\"\r",
              "            }\r",
              "        ];\r",
              "\r",
              "        await api.sendToAdjustment(event.id, moderationComments)\r",
              "\r",
              "        pm.collectionVariables.set(\"userId\", user.id);\r",
              "        pm.collectionVariables.set(\"eventId\", event.id);\r",
              "        pm.collectionVariables.set(\"moderationComments\", JSON.stringify(moderationComments));\r",
              "\r",
              "    } catch (err) {\r",
              "        console.error(\"Ошибка при подготовке тестовых данных.\", err);\r",
              "    }\r",
              "};\r",
              "\r",
              "const interval = setInterval(() => { }, 1000);\r",
              "\r",
              "setTimeout(async () => {\r",
              "    try {\r",
              "        await main();\r",
              "    } finally {\r",
              "        clearInterval(interval);\r",
              "    }\r",
              "}, 100);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ответ должен содержать код статуса 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Событие должно требовать корректировки\", function () {\r",
              "    pm.expect(body.state).to.eql(\"REQUIRES_ADJUSTMENT\");\r",
              "});\r",
              "\r",
              "pm.test(\"В ответе присутствуют комментарии администратора\", function () {\r",
              "    pm.expect(body.moderationComments).to.be.an(\"array\");\r",
              "    pm.expect(body.moderationComments.length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Количество комментариев совпадает\", function () {\r",
              "\r",
              "    const expected =\r",
              "        JSON.parse(pm.collectionVariables.get(\"moderationComments\"));\r",
              "\r",
              "    pm.expect(body.moderationComments.length)\r",
              "        .to.eql(expected.length);\r",
              "});\r",
              "\r",
              "pm.test(\"Тексты комментариев совпадают\", function () {\r",
              "    const expected = JSON.parse(\r",
              "        pm.collectionVariables.get(\"moderationComments\")\r",
              "    );\r",
              "\r",
              "    const actualContents = body.moderationComments\r",
              "        .map(c => c.content);\r",
              "\r",
              "    expected.forEach(comment => {\r",
              "        pm.expect(actualContents).to.include(comment.content);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
